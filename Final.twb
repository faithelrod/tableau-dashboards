    </worksheet>
    <worksheet name='Discount Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Discounts over 20% Hurt Profit</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='Sample - Superstore' />
          </datasources>
          <datasource-dependencies datasource='Sample - Superstore'>
            <column caption='Profit per order' datatype='real' name='[Calculation_1011058123754815489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / COUNTD([Order ID])' />
            </column>
            <column caption='Discount grouping' datatype='string' name='[Calculation_1011058123755008002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;0%&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.1 THEN &quot;10%&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.2 THEN &quot;20%&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.3 THEN &quot;30%&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.4 THEN &quot;40%&quot;&#13;&#10;ELSE &quot;50%+&quot;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1011058123755008002]' derivation='None' name='[none:Calculation_1011058123755008002:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1011058123754815489]' derivation='User' name='[usr:Calculation_1011058123754815489:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[Sample - Superstore].[none:Calculation_1011058123755008002:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;0\%&quot;</bucket>
              <bucket>&quot;10\%&quot;</bucket>
              <bucket>&quot;20\%&quot;</bucket>
              <bucket>&quot;30\%&quot;</bucket>
              <bucket>&quot;40\%&quot;</bucket>
              <bucket>&quot;50\%+&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[Sample - Superstore].[usr:Calculation_1011058123754815489:qk]' scope='rows' value='Avg Profit per Order' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[Sample - Superstore].[usr:Calculation_1011058123754815489:qk]' value='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' />
          </style-rule>
          <style-rule element='refline'>
            <format attr='fill-above' id='refline0' value='#00000000' />
            <format attr='fill-below' id='refline0' value='#00000000' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='stroke-size' scope='cols' value='0' />
            <format attr='stroke-size' scope='rows' value='0' />
            <format attr='line-visibility' scope='rows' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <reference-line axis-column='[Sample - Superstore].[usr:Calculation_1011058123754815489:qk]' enable-instant-analytics='true' formula='constant' id='refline0' label-type='value' scope='per-pane' value='0.0' value-column='[Sample - Superstore].[usr:Calculation_1011058123754815489:qk]' z-order='1' />
            <style>
              <style-rule element='mark'>
                <format attr='size' value='2' />
                <format attr='mark-color' value='#4e79a7' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[Sample - Superstore].[usr:Calculation_1011058123754815489:qk]</rows>
