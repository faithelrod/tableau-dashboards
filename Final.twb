      </table>
      <simple-id uuid='{2CE36B94-63F8-450E-BF13-DDD7ED69D148}' />
    </worksheet>
    <worksheet name='KPI- Profit Margin'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Profit Margin</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='Sample - Superstore' />
          </datasources>
          <datasource-dependencies datasource='Sample - Superstore'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_1011058123754725376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Profit] / [Sales])/100' />
